# =============================================================================
# WordPress Docker Environment — Konfiguracja
# Skopiuj ten plik jako .env i dostosuj do swoich potrzeb
# =============================================================================

# Nazwa projektu — używana dla nazw kontenerów i woluminów Docker
PROJECT_NAME=mywordpress

# ─── WordPress ────────────────────────────────────────────────────────────────
# Port HTTP dostępny z hosta
WP_PORT=8000
# Domena (bez http://) — używana w wp-config.php
WP_DOMAIN=localhost
# Tryb debugowania WordPress (true/false)
WP_DEBUG=false
# Prefiks tabel bazy danych
WP_TABLE_PREFIX=wp_

# ─── PHP ──────────────────────────────────────────────────────────────────────
# Wersja PHP (dostępne: 8.2, 8.3, 8.4)
PHP_VERSION=8.4
# Limit pamięci PHP dla WordPressa
PHP_MEMORY_LIMIT=256M
# Maksymalny limit pamięci WordPress (dla importu, aktualizacji)
WP_MAX_MEMORY_LIMIT=512M
# UID użytkownika hosta (sprawdź: id -u) — umożliwia edycję plików w VS Code bez sudo
HOST_UID=1000

# ─── Baza danych MySQL ────────────────────────────────────────────────────────
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=wordpress_secret
DB_ROOT_PASSWORD=root_secret

# ─── phpMyAdmin ───────────────────────────────────────────────────────────────
PMA_PORT=8080

# ─── Mailpit (SMTP + Web UI) ──────────────────────────────────────────────────
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
